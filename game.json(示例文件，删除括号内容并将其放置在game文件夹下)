  "scenes": {
    "start": {
      "text": "猩红漩涡撕裂天际，祖国人降临纽约上空，感知到三股超越凡俗的力量。他狂笑宣战，要求一对一决斗。\n你已进入虚空竞技场，请选择你的操控角色。",
      "options": [
        {
          "text": "超人（希望是永不熄灭的太阳）",
          "next_scene": "s_up0",
          "effects": [
            { "type": "set_global_flag", "key": "selected_character", "value": "超人" },
            { "type": "set_global_flag", "key": "已选择角色", "value": true },
            { "type": "set_flag", "target": "超人", "key": "已选择", "value": true }
          ]
        },
        {
          "text": "全能侠（强者不需要借口）",
          "next_scene": "s_om0",
          "effects": [
            { "type": "set_global_flag", "key": "selected_character", "value": "全能侠" },
            { "type": "set_global_flag", "key": "已选择角色", "value": true },
            { "type": "set_flag", "target": "全能侠", "key": "已选择", "value": true }
          ]
        },
        {
          "text": "埼玉（兴趣使然的英雄）",
          "next_scene": "s_sai0",
          "effects": [
            { "type": "set_global_flag", "key": "selected_character", "value": "埼玉" },
            { "type": "set_global_flag", "key": "已选择角色", "value": true },
            { "type": "set_flag", "target": "埼玉", "key": "已选择", "value": true }
          ]
        }
      ]
    },
    "s_up0": {
      "text": "午后的纽约，阳光被一道突然撕裂天际的猩红漩涡吞没。漩涡中心，一个身着星条旗披风的男人缓缓降下，他嘴角挂着享受万众惊恐的弧度——祖国人。\n超人双臂交叉，斗篷在风中猎猎作响，眼神平静却带着审慎的威严。哈德逊河的波光倒映着两尊“神明”的影子，云层被他们的气场搅动成旋涡。\n祖国人率先开口：“哎呀，一个穿紧身衣的童子军？我得说，你比我预想的更……土气。”\n超人没有笑，他缓缓下降十米，使自己的目光与祖国人平齐：“我不知道你来自哪个世界，但你脚下的城市里，有八百万人正在看着你。你打算怎么做，证明你的‘强大’？”\n祖国人歪了歪头，热视线在眼眶中微微闪红。",
      "options": [
        {
          "text": "主动出击——热视线抢先压制",
          "next_scene": "s_up1",
          "effects": [
            { "type": "add_attribute", "target": "超人", "attribute": "能量", "value": -20 },
            { "type": "set_flag", "target": "祖国人", "key": "已见面", "value": true }
          ]
        },
        {
          "text": "悬停对峙——先发制人，质问其目的",
          "next_scene": "s_upB1"
        },
        {
          "text": "优先保护下方市民——先救人再回头",
          "next_scene": "s_upC1"
        }
      ]
    },
    "s_up1": {
      "text": "超人双眼骤然射出深红色热视线，直取祖国人胸口。两束血红的光芒在曼哈顿上空激撞，爆发出刺目的白炽光球。空气被电离，臭氧味弥漫。\n祖国人惊讶于对方的热视线竟能与自己抗衡，他咬紧牙关，加大功率，光球向他的一方推移了半米。超人额头微皱，他察觉到祖国人眼中闪烁的不仅是能量，更是某种近乎癫狂的兴奋。\n下方的摩天楼玻璃幕墙被冲击波震碎成雪花瀑布，警笛声淹没在轰鸣中。两人在光柱对撞的中心纹丝不动，但能量消耗以每秒数十点计。\n祖国人突然狂笑：“你的眼睛……和我的很像！但你不敢像我一样烧掉那些蝼蚁吧？”",
      "options": [
        {
          "text": "全力灌注，比拼能量储备",
          "next_scene": "s_up1_1",
          "effects": [
            { "type": "add_attribute", "target": "超人", "attribute": "能量", "value": -40 }
          ]
        },
        {
          "text": "突然转向，利用大楼作掩体",
          "next_scene": "s_up1_2"
        },
        {
          "text": "暂停攻击，试图对话感化",
          "next_scene": "s_up1_3"
        }
      ]
    },
    "s_up1_1": {
      "text": "超人全功率发射，热视线化为一道太阳般的光柱，将祖国人推出的光球硬生生压回。祖国人双脚在空中退后数米，脸上第一次闪过惊愕。他怒吼着将全部能量注入双眼，双目几乎要滴出血来。\n两道光柱交汇处，空气燃烧成等离子态，天空仿佛裂开第二道太阳。下方中央公园的树木开始自燃，湖水蒸发成雾。超人感觉到了祖国人的反抗强度——他确实很强，但似乎已经触及了天花板。",
      "options": [
        {
          "text": "全力灌注，试图瞬间压倒",
          "next_scene": "s_up1_1_1"
        },
        {
          "text": "边对拼边接近，准备近身重击",
          "next_scene": "s_up1_1_2"
        },
        {
          "text": "故意减弱力量，引诱祖国人冒进",
          "next_scene": "s_up1_1_3"
        }
      ]
    },
    "s_up1_1_1": {
      "text": "超人将剩余大部分能量瞬间爆发，热视线化为耀眼金芒，企图直接洞穿祖国人的防御。光芒吞没了一切，祖国人在刺目的光束中发出一声不甘的怒吼，随后他的身影被光柱完全淹没。\n当光芒散去，祖国人如断线的风筝般向哈德逊河坠落，胸前留下一道焦黑的痕迹。他失去了意识，被河水吞没。\n超人的能量也几乎耗尽，他悬在空中，喘息着，看着渐渐平息的河面。他赢了，但内心没有胜利的喜悦，只有一丝遗憾——未能用对话解决。",
      "next_scene": "end"
    },
    "s_up1_1_2": {
      "text": "超人维持热视线输出，同时双脚发力向前猛冲。两具钢铁之躯在五十米高空猛烈对撞，拳脚带起的冲击波将周围云层撕成碎片。\n超人一拳砸在祖国人脸上，将其打入附近一栋大楼的玻璃幕墙，碎玻璃如冰雹飞溅；祖国人从废墟中冲出，一记下勾拳击中超人腹部，超人身形微晃，但随即抓住祖国人的披风将其抛向哈德逊河。\n两人在坠落过程中继续互殴，拳头与空气摩擦出火光。祖国人嘴角流血，却笑得更狂：“对，就是这样！你不是圣人吗？打啊！”\n超人咬着牙：“这跟圣不圣人无关，我是在阻止你伤害无辜。”",
      "options": [
        {
          "text": "过肩摔加冰冻束缚",
          "next_scene": "s_up1_1_2_1"
        },
        {
          "text": "高空升天，带离地球",
          "next_scene": "s_up1_1_2_2"
        },
        {
          "text": "拳拳到肉，彻底击垮",
          "next_scene": "s_up1_1_2_3"
        }
      ]
    },
    "s_up1_1_2_1": {
      "text": "超人将祖国人砸入哈德逊河，瞬间吐息冻结了方圆百米的河水。祖国人被卡在冰层之中，只露出头胸，他疯狂扭动，冰面喀嚓作响。\n超人悬停在冰面上方，俯视他：“够了。你已经输了。放下你的傲慢，我可以帮你找到更好的路。”\n祖国人抬头，眼中怒火与惊惧交织：“帮我？你算什么东西……你以为这样就能羞辱我？！”他双眼猛地亮起，试图用热视线融化冰层，但超人更快——俯身按住他的额头，热视线从指缝间射出，贴着祖国人的头皮烧过，警告之意十足。",
      "options": [
        {
          "text": "继续劝降，以自身孤儿经历共情",
          "next_scene": "s_up1_1_2_1_1",
          "conditions": [
            { "type": "attribute", "target": "超人", "attribute": "能量", "operator": ">=", "value": 100 }
          ]
        },
        {
          "text": "直接击晕，一记手刀结束战斗",
          "next_scene": "s_up1_1_2_1_2"
        },
        {
          "text": "拔除其能量核心，使其失去力量",
          "next_scene": "s_up1_1_2_1_3"
        }
      ]
    },
    "s_up1_1_2_1_1": {
      "text": "超人蹲下，真诚地讲述自己作为外星孤儿的成长经历：“我失去了整个星球，我知道孤独的滋味。你不需要这样活着，你的力量可以用来保护人，而不是毁灭。”\n祖国人愣住了，冰面渐渐融化，他的眼神从凶狠变为迷茫，又变为湿润。他低声说：“我……能重新开始吗？”\n超人伸出手，祖国人颤抖着握住了它。两人在哈德逊河上达成了和解。",
      "next_scene": "end"
    },
    "s_up1_1_2_1_2": {
      "text": "超人一记手刀切在祖国人颈侧，以精确力量使其晕厥。祖国人的身体软了下来，超人将他提起，飞向专门为超级罪犯打造的隔绝监狱。\n祖国人在铁窗中咆哮，但渐渐学会沉默。超人对他的处置让世界感到安心，但超人自己知道，这只是一个暂时的解决方案。",
      "next_scene": "end"
    },
    "s_up1_1_2_1_3": {
      "text": "超人深入感知祖国人的生理，发现其能量来源可能与某种化合物有关。他用热视线精确破坏其能量核心，祖国人发出一声惨叫，身体迅速萎靡下去。\n超人的行为引发了争议——祖国人失去了所有超能力，成为了一个凡人。有人称其为正义，有人谴责为残忍。超人在舆论的漩涡中沉默了很久。",
      "next_scene": "end"
    },
    "s_up1_1_2_2": {
      "text": "超人紧抱祖国人直线上升，气压骤降，云层被撞开一个巨洞。祖国人在怀中挣扎，拳打脚踢，但超人的手臂如钛合金钳。\n到一万五千米高空时，空气稀薄到人类无法呼吸，但两人皆无需呼吸。祖国人狂笑：“你以为把我带到这儿就能赢？我知道你舍不得城市，可我不在乎！”他反手一拳打在超人太阳穴，超人松脱了半秒，祖国人挣脱，两人在平流层边缘对峙。",
      "options": [
        {
          "text": "太阳充能，吸收太阳能恢复能量",
          "next_scene": "s_up1_1_2_2_1"
        },
        {
          "text": "高速追逐战，制造真空龙卷",
          "next_scene": "s_up1_1_2_2_2"
        },
        {
          "text": "模拟地球引力，利用高度差实施重击",
          "next_scene": "s_up1_1_2_2_3"
        }
      ]
    },
    "s_up1_1_2_2_1": {
      "text": "超人张开双臂迎向阳光，短暂吸收太阳能恢复能量。祖国人见状猛冲过来，热视线全开，但超人已经恢复了不少力量。\n两束目光再次对撞，这次超人占据上风。祖国人被持续压制，最终在能量耗尽后被超人一拳击晕，从高空坠落，被超人接住带回了地面。",
      "next_scene": "end"
    },
    "s_up1_1_2_2_2": {
      "text": "超人率先发动超音速冲刺，绕圈飞行制造真空龙卷，将祖国人困在风眼之中。祖国人试图冲出，但每一次都被强烈的气流弹回。\n几分钟后，祖国人因缺氧和极度眩晕而失去意识，倒在了风眼中心。超人停止了旋转，将他拎起，带回了地面。",
      "next_scene": "end"
    },
    "s_up1_1_2_2_3": {
      "text": "超人故意下降诱敌，待祖国人俯冲时突然反向升空，利用惯性和高度落差实施一记沉重的膝撞。祖国人完全没有预料到这一变化，被直接命中腹部，身体弓成了一个虾米，失去了战斗能力。",
      "next_scene": "end"
    },
    "s_up1_1_2_3": {
      "text": "超人放弃了所有防御，双拳如暴雨般落在祖国人身上，每一击都足以粉碎山脉。祖国人起初硬扛，但很快开始吐血，他的肋骨断裂声在空气中清晰可闻。\n祖国人从牙缝里挤出嘶吼：“你……杀不了我……我比你强！”他忽然张开双臂，全身爆发出刺目的热视线光芒——他要用奥义「天罚降临」同归于尽。\n超人瞳孔骤缩：若他完成蓄力，整个纽约都会蒸发。",
      "options": [
        {
          "text": "打断蓄力，一拳击中其下颚",
          "next_scene": "s_up1_1_2_3_1"
        },
        {
          "text": "以身承伤，用披风罩住祖国人将奥义引向天空",
          "next_scene": "s_up1_1_2_3_2"
        },
        {
          "text": "联合市民声音，用超级音量喊话干扰其蓄力",
          "next_scene": "s_up1_1_2_3_3"
        }
      ]
    },
    "s_up1_1_2_3_1": {
      "text": "超人全速上前，一拳击中祖国人下颚。力量控制得恰到好处，祖国人的能量被中断，身体软倒，失去了意识。\n超人的拳头微微颤抖，他几乎越过了那条线。但他没有，他守住了自己的原则。",
      "next_scene": "end"
    },
    "s_up1_1_2_3_2": {
      "text": "超人展开披风，罩住祖国人，将奥义的爆发方向引向天空。巨大的能量冲击让超人身受重伤，但城市安然无恙。\n祖国人因反噬而暂时失明，被超人制服。事后，超人躺在医院接受阳光疗愈，嘴角带着微笑——他守护了这座城市。",
      "next_scene": "end"
    },
    "s_up1_1_2_3_3": {
      "text": "超人突然用超级音量喊话：“纽约的大家！我需要你们一起喊——‘放下武器’！”下方传来震耳欲聋的齐声呼喊。\n祖国人因分心而蓄力不稳，错失良机。超人趁势上前，一记重拳将他击退。祖国人捂着胸口，脸色铁青，他从未想过这些“蝼蚁”的声音能影响他。\n最终，祖国人在心理和肉体的双重打击下认输了。",
      "next_scene": "end"
    },
    "s_up1_1_3": {
      "text": "超人故意让热视线颤抖减弱，表现出能量不支的样子。祖国人眼中闪过狂喜：“终于撑不住了！”他骤然将能量全开，热视线狂暴推进。\n就在两道光柱即将吞没超人的刹那，超人侧身闪避，同时一道冰冷的白雾从口中喷出——冰冻呼吸迎面击中祖国人的面门。\n祖国人整个上半身瞬间凝结冰霜，热视线熄灭，他像块石头般向下方坠落。超人加速俯冲，一把抓住他的披风，将其提起。祖国人的睫毛上挂着冰凌，眼神第一次出现了恐惧。",
      "options": [
        {
          "text": "空中压制，将其投掷向大海",
          "next_scene": "s_up1_1_3_1"
        },
        {
          "text": "冰封终结，将其包裹在冰层中",
          "next_scene": "s_up1_1_3_2"
        },
        {
          "text": "对话再度，融化其头部冰霜后进行劝解",
          "next_scene": "s_up1_1_3_3"
        }
      ]
    },
    "s_up1_1_3_1": {
      "text": "超人将祖国人掷向大西洋，自己以超音速追上。两人在浪尖上缠斗，海水被他们的碰撞激成几十米高的水墙。\n祖国人解冻了部分身体，一拳击碎一道浪花，但超人从浪后现身，一脚踩着他的背将其压入海底。\n深海压力让祖国人行动困难，他瞪大眼睛用热视线切割海水，但光束被折射分散。最终，超人用泥土和岩石将他掩埋在海床中，然后将其带回海岸。",
      "next_scene": "end"
    },
    "s_up1_1_3_2": {
      "text": "超人不给对方解冻机会，连续吐出冷冻呼吸，将祖国人整个包裹在冰层中，形成一个巨大的冰棺，悬挂在帝国大厦顶端。\n祖国人在冰中保留意识，直至冰化后被移交处置。超人看着那个冰雕，摇了摇头。",
      "next_scene": "end"
    },
    "s_up1_1_3_3": {
      "text": "超人提着冻结的祖国人，飞到一处安静的屋顶，放下他。他用热视线慢慢融化其头部冰霜，让他能说话。\n“现在，你愿意听我说了吗？”超人的声音带着真诚。\n祖国人沉默了很久，最终垂下了头。超人伸出手，祖国人握住它，两人在屋顶坐了很久，直到日落。",
      "next_scene": "end"
    },
    "s_up1_2": {
      "text": "超人热视线熔断钢架后，身形如红蓝闪电般穿入在建大楼的框架中。祖国人狞笑着紧随其后，两道身影在玻璃幕墙间折射穿梭。\n阳光被破碎的镜面切割成千万片光斑，祖国人的热视线扫过，钢化玻璃爆裂成雪白粉尘。\n超人故意在一面巨大的落地镜前急停，祖国人一拳打碎镜面，却只击中幻影——超人已绕至其背后，一脚踹中他的脊柱，将其踢穿三层楼板。",
      "options": [
        {
          "text": "穿楼突袭，打乱对方节奏",
          "next_scene": "s_up1_2_1"
        },
        {
          "text": "绕至阳光方向，用强光致盲",
          "next_scene": "s_up1_2_2"
        },
        {
          "text": "拆下大楼钢架当作投掷武器",
          "next_scene": "s_up1_2_3"
        }
      ]
    },
    "s_up1_2_1": {
      "text": "超人从大楼东墙破洞飞出，在夕阳映照的空中划出一道弧线，一拳正中祖国人侧脸，将其击入隔壁的写字楼。\n祖国人撞穿三层玻璃幕墙，最后砸在办公区的隔断墙上。打印机、文件纸片漫天飞舞，职员尖叫逃散。\n祖国人从碎屑中站起，抹去嘴角的血，眼中杀意沸腾：“你竟敢让这些蝼蚁看见我狼狈的样子？”他双手张开，热视线呈扇形扫射，楼内家具纷纷燃烧。\n超人急速穿梭于火海中，抓住祖国人披风后摆，猛地将他拽出大楼，甩向中央公园的草地。",
      "options": [
        {
          "text": "阻止建筑倒塌，先确保楼内人员安全",
          "next_scene": "s_up1_2_1_1"
        },
        {
          "text": "继续追击，在公园草坪上展开肉搏",
          "next_scene": "s_up1_2_1_2"
        },
        {
          "text": "战略性后退，引诱祖国人离开公园上空",
          "next_scene": "s_up1_2_1_3"
        }
      ]
    },
    "s_up1_2_1_1": {
      "text": "超人感知到被撞的大楼结构不稳，他先俯冲用热视线焊接断裂的钢架，确保楼内人员安全。\n背后热视线已至，他侧身，右肩被擦过，披风冒烟。祖国人狞笑：“你总是分心。”\n超人转身，眼神如铁：“分心是因为有人值得救，而你永远不懂。”他猛地冲前，双手擒住祖国人双腕，将其热视线方向扭向天空，炽白光束划破晚霞。\n经过一番激烈的搏斗，超人最终用膝盖顶其腹部，然后冻住其双腿。祖国人被困，超人呼叫军方接管。",
      "next_scene": "end"
    },
    "s_up1_2_1_2": {
      "text": "两人在中央公园草坪上展开肉搏。拳风割草，地面被踩出陨石坑。祖国人一拳砸在超人胸口，超人只闷哼一声，反手一肘击碎祖国人鼻梁骨，鲜血溅上绿色草叶。\n祖国人狂吼着张开嘴，试图咬住超人的喉咙——超人偏头，顺势将他按进人工湖里。水花冲天，鱼群惊散。\n最终，超人将祖国人拖出水面，一拳拳击打直至他失去意识。祖国人最后挣扎释放热视线，却被超人用手掌挡住，掌心灼烧但咬牙坚持。",
      "next_scene": "end"
    },
    "s_up1_2_1_3": {
      "text": "超人转身向哈德逊河飞去，祖国人果然追上：“逃跑？不像你的风格。”两人在河面上空百米处对峙，游轮上的游客疯狂拍照。\n超人突然停住，转身笑道：“你上当了。”他双手猛砸水面，激起百米水幕，将祖国人视线完全遮蔽，随后从水幕中穿出，一记升龙拳将其打得垂直上升。\n最终，超人降落在自由女神像上，等待祖国人下来。在自由女神像上，超人利用象征意义刺激了祖国人，在雕像上将其制服。",
      "next_scene": "end"
    },
    "s_up1_2_2": {
      "text": "超人借助夕阳的余晖，自身高速旋转调整角度，将阳光反射进祖国人眼中。祖国人双眼剧痛，热视线失控，胡乱扫射。\n超人趁机吐出冷冻呼吸，将祖国人四周的空气凝成冰晶，迅速形成一个直径五米的冰球。祖国人被困在冰中，仅能看到朦胧的光影。\n超人悬停在冰球上方，说：“你败给的不是我，是光明。”",
      "next_scene": "end"
    },
    "s_up1_2_3": {
      "text": "超人拆下一根工字钢梁，以超级力量投掷向祖国人，同时自己向上飞升，准备从高处俯冲打击。\n钢梁如导弹般飞向祖国人，后者侧身躲过，钢梁刺入身后的摩天楼外墙。但超人已在钢梁飞出的同时上升到五百米高处，接着垂直俯冲，双手合拢如流星锤。\n祖国人抬头时，超人的拳头已至——一击命中他的额头，将其砸向下方的百老汇大街。祖国人在坠地前紧急悬停，离路面仅三米。\n最终，超人趁祖国人未站稳，连续俯冲打击，不给他喘息。祖国人勉强格挡，但被打进地铁站入口。",
      "next_scene": "end"
    },
    "s_up1_3": {
      "text": "超人收起热视线，平举双手。祖国人眯着眼，但没攻击：“你想说什么？求饶？”\n超人摇头：“我想告诉你——你不是怪物，你只是被制造出来的武器。”",
      "options": [
        {
          "text": "直言祖国人的童年创伤",
          "next_scene": "s_up1_3_1"
        },
        {
          "text": "以自己氪星孤儿的身份共情",
          "next_scene": "s_up1_3_2"
        },
        {
          "text": "警告其行为会让他永远得不到爱",
          "next_scene": "s_up1_3_3"
        }
      ]
    },
    "s_up1_3_1": {
      "text": "超人不断点破祖国人内心的空洞——沃特公司的操控、实验室的孤独。祖国人暴怒攻击，但超人闪避并继续揭露。\n最终，祖国人颓然放弃抵抗，蹲在空中低声承认“我只是害怕孤独”。超人陪伴他直到其情绪平复。",
      "next_scene": "end"
    },
    "s_up1_3_2": {
      "text": "超人分享自己失去母星的孤独：“我失去过整个星球，所以我知道孤独的滋味。”\n祖国人第一次流露出困惑，两人暂停战斗，但祖国人转瞬又想偷袭。超人预判躲开，随后用严肃语气说：“我理解你，但我不会原谅你的选择。”\n最终，祖国人颤抖着伸出手，停在了半空，小声说：“我……能重新开始吗？”",
      "next_scene": "end"
    },
    "s_up1_3_3": {
      "text": "超人平静地说：“你这样做，永远得不到真正的认可和爱。你只会坐在一个孤独的王座上。”\n祖国人疯狂大笑，但笑声中带着苦楚，他启动奥义「天罚降临」。\n超人用热视线精准击穿他的肩膀，使其失去准头。奥义炸裂天空，但下方城市被冲击波震动，无人伤亡。\n祖国人无力地坠落，超人接住了他。",
      "next_scene": "end"
    },
    "s_upB1": {
      "text": "超人悬停不动，用平静而穿透力强的声音询问：“你为什么要来这儿？你渴望的到底是什么？”\n祖国人脸上的假笑瞬间凝固，他眯起眼：“闭嘴，你懂什么？”\n超人继续说：“我懂，因为我也是最后一个氪星人。”",
      "options": [
        {
          "text": "揭露祖国人的真实背景，激怒他",
          "next_scene": "s_upB1_1"
        },
        {
          "text": "提出联手保护地球，试探底线",
          "next_scene": "s_upB1_2"
        },
        {
          "text": "静待对方先出手，后发制人",
          "next_scene": "s_upB1_3"
        }
      ]
    },
    "s_upB1_1": {
      "text": "超人直言祖国人不过是沃特公司的实验产物。祖国人发狂，热视线如狂风骤雨般袭来。\n超人闪避其疯狂攻击，等待破绽。祖国人的攻击越来越狂乱，能量消耗也越来越快。\n最终，祖国人体力耗尽，超人一击制胜，将其按倒在地。",
      "next_scene": "end"
    },
    "s_upB1_2": {
      "text": "超人提出联手保护地球：“我们的力量可以用于保护，而不是争斗。”\n祖国人犹豫了一下，说道：“我还没想好。”然后转身飞走，超人不追击，只是对着他的背影警告道：“别再回来。”",
      "next_scene": "end"
    },
    "s_upB1_3": {
      "text": "超人闭上眼睛，凭气流和心跳感知祖国人的位置。祖国人刚一抬臂准备攻击，超人已到他背后，轻轻一击后颈，祖国人晕倒。\n超人睁开眼，说：“有时候，眼睛会骗人。”",
      "next_scene": "end"
    },
    "s_upC1": {
      "text": "超人感知到一辆失控的观光直升机正旋向下坠，他骤然加速冲去，先救人再回头。\n他俯冲，在半空接住直升机，轻轻放在楼顶。回身时，祖国人的热视线已瞄准他怀中的乘客。",
      "options": [
        {
          "text": "用身体护住客机，硬接热视线",
          "next_scene": "s_upC1_1"
        },
        {
          "text": "以身作盾，挡在祖国人与城市之间",
          "next_scene": "s_upC1_2"
        },
        {
          "text": "引诱祖国人远离市区，至无人区",
          "next_scene": "s_upC1_3"
        }
      ]
    },
    "s_upC1_1": {
      "text": "超人用背部挡下热视线，披风烧出一个洞。他强忍疼痛，放下乘客后转身一拳将祖国人打飞。\n超人的背部皮肤灼红，但他咬牙坚持，在接住更多坠落物后，最终制服了祖国人。",
      "next_scene": "end"
    },
    "s_upC1_2": {
      "text": "超人以身作盾，将祖国人一步步推向大海。祖国人的热视线不断轰击在超人身上，但超人不为所动。\n到海上后，超人发起反击，用海浪和冰霜将祖国人包裹起来，最终将其制服。",
      "next_scene": "end"
    },
    "s_upC1_3": {
      "text": "超人超音速向大西洋方向飞行，祖国人紧追不舍。两人在云层之上追逐，最终降落到自由女神像。\n超人以女神像的火炬为支点，旋转一圈将祖国人甩入海中，随后用热视线在女神像基座刻下“和平”二字。\n祖国人浮上海面，望着雕像，第一次无言以对。",
      "next_scene": "end"
    },
    "s_om0": {
      "text": "猩红漩涡撕裂天际，祖国人狂笑着降临，感知到三股超越常理的力量。他宣称自己才是唯一真神，并点名要“一个一个撕碎你们”。\n全能侠悬浮于高空，眯起眼睛——他认出了这种眼神，那是千百年来他见过的无数暴君的眼神。\n全能侠没有退缩，甚至嘴角露出一丝冷笑：“你让我想起年轻的自己——可惜，你还不够格。”",
      "options": [
        {
          "text": "直接发动超光速冲撞，以绝对速度撕开战局",
          "next_scene": "s_om1"
        },
        {
          "text": "利用纽约大楼作为武器，进行环境压制",
          "next_scene": "s_om2"
        },
        {
          "text": "先言语试探，保留底牌，观察祖国人弱点",
          "next_scene": "s_om3"
        }
      ]
    },
    "s_om1": {
      "text": "纽约上空的空气在刹那间被撕成两半——全能侠几乎没有预兆，身形消失，仅留下一圈环状音爆云炸裂开来。\n在十分之一秒后，他的膝盖已经冲到祖国人面前，后者瞳孔骤缩，本能地双臂交叉格挡。一声沉闷的撞击声如巨钟轰鸣，祖国人被这股无法抗拒的蛮力撞得向后滑翔近百米。\n祖国人甩了甩发麻的手臂，脸上闪过一丝难以置信——然后咧开嘴，露出一个更疯狂的笑容。",
      "options": [
        {
          "text": "连续追击，以铁拳连环压制",
          "next_scene": "s_om1_1"
        },
        {
          "text": "假意后退，引诱祖国人追击，再反身踢击",
          "next_scene": "s_om1_2"
        },
        {
          "text": "利用冲撞惯性，抓起楼顶水塔砸向祖国人",
          "next_scene": "s_om1_3"
        }
      ]
    },
    "s_om1_1": {
      "text": "全能侠不给他喘息之机，双拳交替轰向祖国人的头胸腹，每一拳都附带足以贯穿坦克的冲击力。\n祖国人被迫举臂硬接，但每一拳都让他后退一步，脚下混凝土楼板寸寸龟裂。连续七拳后，祖国人的防御出现空隙。",
      "options": [
        {
          "text": "全力猛攻，以维特鲁姆力量打穿祖国人防御",
          "next_scene": "s_om1_1_1"
        },
        {
          "text": "转为关节技，试图锁住祖国人",
          "next_scene": "s_om1_1_2"
        },
        {
          "text": "故意卖破绽，引诱祖国人热视线攻击，再反手肘击",
          "next_scene": "s_om1_1_3"
        }
      ]
    },
    "s_om1_1_1": {
      "text": "全能侠的右拳贯穿祖国人的交叉防御，直击其胸膛，发出骨裂的脆响。祖国人喷出一口鲜血，眼球爆突，身体如断线风筝般坠向哈德逊河。\n全能侠悬于高空，俯视着河面渐渐浮起的身体，冷笑一声：“你连维特鲁姆的新兵都不如。”",
      "next_scene": "end"
    },
    "s_om1_1_2": {
      "text": "全能侠双臂如铁箍般缠上祖国人的右臂，试图将他的肘关节反向折断。祖国人用左手热视线近距发射，灼烧全能侠的肩膀。\n全能侠不顾肩部烧伤，怒吼着将力量提升到九成，硬生生折断祖国人的右臂。祖国人惨叫，但因剧痛而疯狂，以热视线无差别扫射大楼。\n全能侠被迫闪避，最终在废墟中将其制服。",
      "next_scene": "end"
    },
    "s_om1_1_3": {
      "text": "全能侠故意放慢一拳，露出左肋空当。祖国人果然中计，瞬发热视线切向那里——全能侠在光束触体前0.01秒侧身，光束擦过他的披风，同时他的右肘已经狠狠砸向祖国人的太阳穴。\n祖国人眼前一黑，几乎失去平衡。全能侠趁胜追击，一脚踩向祖国人胸口，将其踩穿楼板，战斗随之结束。",
      "next_scene": "end"
    },
    "s_om1_2": {
      "text": "全能侠一击得手后竟转身向后飞，做出“不过如此”的轻蔑姿态。祖国人果然被激怒，大吼着以超音速追击。\n就在他即将碰到全能侠后背时，全能侠突然在空中扭腰转身，一记横扫腿划出半月弧光，直取祖国人颈侧。",
      "options": [
        {
          "text": "反身踢中祖国人头部",
          "next_scene": "s_om1_2_1"
        },
        {
          "text": "祖国人识破诡计，反手抓住全能侠脚踝",
          "next_scene": "s_om1_2_2"
        },
        {
          "text": "借踢击之力拉开距离，准备第二次冲撞",
          "next_scene": "s_om1_2_3"
        }
      ]
    },
    "s_om1_2_1": {
      "text": "全能侠反身踢中祖国人太阳穴，祖国人瞬间晕厥，从高空坠落。全能侠俯冲抓住他的披风，将其提在半空。\n他将祖国人悬挂在帝国大厦尖顶之上，供所有人围观。祖国人醒来时羞耻至极，但无力挣脱。最终，沃特公司以巨大代价“赎回”祖国人。",
      "next_scene": "end"
    },
    "s_om1_2_2": {
      "text": "祖国人在最后一刻抓住了全能侠的脚踝，两人纠缠着撞入一栋高楼。祖国人用热视线切割承重柱，整栋楼开始倾斜。\n在废墟底下，两人扭打，最终全能侠用一块钢筋插穿祖国人的心脏。当他从瓦砾中爬出，满身是血，面对满目疮痍的城市，他双膝跪地——这是他第一次为胜利而感到空虚。",
      "next_scene": "end"
    },
    "s_om1_2_3": {
      "text": "全能侠以两倍音速再次冲撞，祖国人不再闪避，而是将全部能量聚集于体表，形成一层金色护盾。\n两人正面碰撞，产生的冲击波将周围千米内的玻璃全部震碎。对撞后，两人同时被弹开，但全能侠更快恢复，他乘势追击，连续重拳打垮祖国人的防御，最终将其击落。",
      "next_scene": "end"
    },
    "s_om1_3": {
      "text": "全能侠注意到旁边楼顶的巨型水塔，他借冲撞后的惯性一个急转，单手插入水塔钢架，将其连根拔起，然后以投掷铅球的姿势猛力甩出。\n水塔带着刺耳的破空声旋转着砸向刚刚稳住身形的祖国人。",
      "options": [
        {
          "text": "水塔砸中祖国人，将其撞入摩天大楼",
          "next_scene": "s_om1_3_1"
        },
        {
          "text": "祖国人用热视线凌空切开水塔，水花遮蔽视线",
          "next_scene": "s_om1_3_2"
        },
        {
          "text": "祖国人闪避，水塔砸向下方街道",
          "next_scene": "s_om1_3_3"
        }
      ]
    },
    "s_om1_3_1": {
      "text": "水塔将祖国人砸入办公楼层，全能侠紧随其后。室内空间狭窄，祖国人的热视线无法大范围施展，而全能侠则利用办公家具作为投掷物，持续压制。\n最终，全能侠抓住祖国人的双腿，将其抡圆了砸穿墙壁，连续穿过三栋楼，最终将他按在洛克菲勒中心顶端，一拳结束战斗。",
      "next_scene": "end"
    },
    "s_om1_3_2": {
      "text": "热视线切开水塔，水花四溅形成巨大水幕，祖国人视线受阻。全能侠瞬间潜入水幕，从盲点精准命中其后颈，一击致昏。\n祖国人坠落在广场上，被赶来的人群团团围住。全能侠降落在旁，对媒体镜头说：“他已经没有威胁了。”",
      "next_scene": "end"
    },
    "s_om1_3_3": {
      "text": "水塔砸向街道，全能侠被迫俯冲救场。他用身体挡住最大的碎片，但背部因此暴露——祖国人从废墟中窜出，热视线贯穿全能侠的右肩。\n全能侠最终将所有平民转移到安全地带，但自己已被热视线重创多处。他跪倒在岸边，祖国人踩着他的头：“你输了，因为你太在乎他们。”\n全能侠喘息着，却露出一丝微笑：“不，是你输了——你永远不懂什么是力量之外的东西。”",
      "next_scene": "end"
    },
    "s_om2": {
      "text": "全能侠抓起半截钢梁，以超高速掷出，钢梁带着刺耳的尖啸飞向祖国人。",
      "options": [
        {
          "text": "连续掷出多根钢梁，封锁祖国人走位",
          "next_scene": "s_om2_1"
        },
        {
          "text": "掷出钢梁后紧跟其后，形成双段夹击",
          "next_scene": "s_om2_2"
        },
        {
          "text": "故意掷偏，让钢梁贯穿附近的直升机，制造混乱",
          "next_scene": "s_om2_3"
        }
      ]
    },
    "s_om2_1": {
      "text": "全能侠接连投掷钢梁，形成立体交叉网，将祖国人困在半空中。祖国人挣扎着用热视线切割，但钢梁太多太快。\n全能侠趁机以连续冲撞将钢梁砸进祖国人的四肢，将其钉在了一座大楼的外墙上。血流如注，祖国人惨叫着却无法移动。\n全能侠飞近，冷冷道：“你现在知道成为猎物的感觉了？”",
      "next_scene": "end"
    },
    "s_om2_2": {
      "text": "钢梁命中祖国人肩部，他身形一滞，全能侠紧跟着的重拳正中面门。祖国人倒飞出去，撞穿布鲁克林大桥的钢缆，挂在桥体上。\n全能侠降落在桥面，走向他。祖国人抬起破碎的脸，嘶哑地说：“你为什么……这么强？”\n全能侠俯身，低声道：“因为你活在童话里，而我活在战争中。”然后扭断了他的脖子。",
      "next_scene": "end"
    },
    "s_om2_3": {
      "text": "钢梁击毁直升机，爆炸烈焰让祖国人躲开全能侠的视线，同时他用热视线引爆了附近的煤气管道，连环爆炸将全能侠卷入火海。\n全能侠冲出火焰时，祖国人已消失。此后数月，祖国人作为地下恐怖分子在纽约制造连环袭击。\n最终在一场雨夜的天台对决中，全能侠用计逼出祖国人，并将其制服，但纽约已付出巨大代价。",
      "next_scene": "end"
    },
    "s_om3": {
      "text": "全能侠悬浮对峙，用低沉声音说：“你是人造的，对吧？实验室的产物。你永远不知道真正的强大是什么。”",
      "options": [
        {
          "text": "直言祖国人是‘实验室制造的小丑’，戳穿他的虚假神性",
          "next_scene": "s_om3_1"
        },
        {
          "text": "用自己儿子的名字唤起‘家人’话题，试探祖国人的情感空白",
          "next_scene": "s_om3_2"
        },
        {
          "text": "沉默片刻，突然以超高速绕后，掐住祖国人后颈",
          "next_scene": "s_om3_3"
        }
      ]
    },
    "s_om3_1": {
      "text": "全能侠直言祖国人不过是实验产物。祖国人狂怒中露出破绽，全能侠一拳打碎其护体能量，然后用维特鲁姆威压迫使其跪倒。\n祖国人跪在地上，哭泣着承认自己的恐惧。全能侠没有杀他，而是将他交给联合国，并提供了沃特公司所有黑料的证据。\n祖国人最终被囚禁于秘密监狱，在全世界的蔑视中度过后半生。",
      "next_scene": "end"
    },
    "s_om3_2": {
      "text": "全能侠提起自己在地球的儿子：“你从未感受过爱，所以你才如此扭曲。”\n祖国人愣住了，眼中闪过一丝从未有过的迷茫。全能侠趁其心神动摇，近身一记重击，但并未下杀手。\n“也许你可以学会。”全能侠说。祖国人破天荒地没有反驳，他默默飞走。全能侠没有追，因为他看到了祖国人眼中的迟疑。",
      "next_scene": "end"
    },
    "s_om3_3": {
      "text": "全能侠绕后掐住祖国人后颈，祖国人无法转头释放热视线，只能徒劳地踢腿。全能侠加大力道，直到祖国人失去知觉。\n他将其带到自由岛，用铁链把他拴在重铸的自由女神像基座上，并在其胸口刻下“我本是凡人”的字样。\n从此，祖国人成为纽约的一个景点，每天被游客围观嘲笑——这是全能侠给他的终极惩罚。",
      "next_scene": "end"
    },
    "s_sai0": {
      "text": "猩红漩涡撕裂天际，祖国人降临，狂笑宣战。超人、全能侠、埼玉同时感知到威胁，但埼玉只是叹了口气——因为他刚得知今天超市有特卖，而这场“决斗”显然要耽误他的时间。\n祖国人俯瞰着埼玉，嘴角的弧度带着冷酷的傲慢：“你，光头，你看起来毫不在意？”\n埼玉缓缓低头看了看手腕上那块电子表——那是他花了299日元买的——数字跳动，显示距离超市特卖结束还有4分58秒。\n他抬起死鱼眼，对祖国人说：“啊，抱歉，我赶时间，你能让让吗？”说完他侧过身，朝着布鲁克林方向作势要飞走。\n远处，超人握紧拳头，低声对全能侠说：“他不应该轻视祖国人……”全能侠眯起眼：“不，那个光头……我感知不到他的上限。”",
      "options": [
        {
          "text": "超市特卖优先——完全无视祖国人，转身飞向超市",
          "next_scene": "s_sai1"
        },
        {
          "text": "稍微有点兴趣——悬浮着问‘你是哪个超市的吉祥物吗？’",
          "next_scene": "s_sai2"
        },
        {
          "text": "被激怒了——祖国人嘲笑埼玉的秃头后认真对待",
          "next_scene": "s_sai3"
        }
      ]
    },
    "s_sai1": {
      "text": "埼玉以亚光速转向，留下一句“超市不等人”，直接朝布鲁克林飞去。祖国人暴怒，双眼瞬间释放出赤红热视线，狠狠扫向埼玉的去路，并切断了下方几栋大楼的顶部，碎石坠落。",
      "options": [
        {
          "text": "埼玉头也不回地飞走，祖国人追击",
          "next_scene": "s_sai1_1"
        },
        {
          "text": "埼玉随手挥出一拳（普通拳）",
          "next_scene": "s_sai1_2"
        },
        {
          "text": "埼玉提议猜拳决定胜负",
          "next_scene": "s_sai1_3"
        }
      ]
    },
    "s_sai1_1": {
      "text": "埼玉像一颗黄色的流星划过天际，背后祖国人怒吼着以超音速紧追不舍。热视线如死亡探照灯般疯狂扫射，数栋摩天大楼的玻璃幕墙接连炸裂。\n埼玉在空中急停，转身，右拳简简单单地朝祖国人的方向挥出。这一拳没带任何技巧，但拳风所过之处，空气被压缩成白色圆锥，瞬间击中祖国人的胸口。\n祖国人被这一拳打得倒飞出数百米，撞穿远处一座摩天大楼的顶层，胸口的制服出现了一个清晰的拳印凹陷。\n埼玉收回拳头，面无表情地说：“别追了，超市真的快关门了。”",
      "next_scene": "end"
    },
    "s_sai1_2": {
      "text": "埼玉连看都没看，右手从口袋里抽出，朝祖国人的方向随意甩了一下——那只是像赶苍蝇一样。然而拳风撕裂空气，发出刺耳的尖啸，如同一枚无形炮弹直奔祖国人面门。\n祖国人勉强偏头躲开要害，但他的右臂被拳风边缘扫中——骨质碎裂的声响清晰可闻。\n他惊骇地瞪大双眼：“你……这不可能……我的身体……”\n埼玉收回拳头，拍了拍手上并不存在的灰尘：“我赶时间，你能让我过去吗？”",
      "next_scene": "end"
    },
    "s_sai1_3": {
      "text": "埼玉突然一本正经地伸出右手：“要不我们石头剪刀布，三局两胜，输的人让路？”祖国人瞪大了眼睛，那是从未有过的侮辱。\n他没有回答，而是直接抬起右掌，一道热视线无声袭来——偷袭。然而热视线在距离埼玉皮肤几毫米处被弹开，如同水滴落在地上的荷叶。\n埼玉低下头，看了看自己的裤子：“啊，差点弄脏。”他决定不再客气。\n埼玉随便一拳正中祖国人胸口，祖国人像流星一样飞向大西洋方向，消失在地平线。",
      "next_scene": "end"
    },
    "s_sai2": {
      "text": "祖国人炫耀性地说“我是你们的神”，埼玉歪着头问：“你是哪个超市的吉祥物吗？胸口那个‘H’……是‘华润万家’的意思？”\n祖国人面部抽搐，他从未被人如此轻视。超人捂住嘴，全能侠却忍不住发出低沉的轻笑。",
      "options": [
        {
          "text": "原地不动，让祖国人先攻",
          "next_scene": "s_sai2_1"
        },
        {
          "text": "先打一拳（普通拳）但故意打偏",
          "next_scene": "s_sai2_2"
        },
        {
          "text": "提议比谁先飞到自由女神像",
          "next_scene": "s_sai2_3"
        }
      ]
    },
    "s_sai2_1": {
      "text": "祖国人全力一拳打在埼玉头上，埼玉毫无反应，连眼皮都没眨一下。他反手握住祖国人的手腕：“你的拳头像按摩。”\n然后他轻轻一甩，将祖国人扔向大海。祖国人在空中翻转数圈才稳住身形，心中第一次产生了真正的恐惧。",
      "next_scene": "end"
    },
    "s_sai2_2": {
      "text": "埼玉一拳故意打偏，祖国人以为埼玉失手，疯狂反击。但埼玉以不可思议的速度连续闪避，祖国人的每一拳都打在了空处。\n祖国人的心态逐渐崩溃，他的攻击越来越混乱。埼玉叹了口气，一记轻轻的耳光将其扇飞。",
      "next_scene": "end"
    },
    "s_sai2_3": {
      "text": "埼玉说：“谁先到自由女神像算谁赢。”他话音未落，人已经站在了自由女神像的火炬上，然后又回到了原地。\n祖国人还没起步，埼玉已经完成了一个来回。祖国人愤怒地摧毁了自由女神像，埼玉无奈地一拳将其修复，并顺手将祖国人击倒。",
      "next_scene": "end"
    },
    "s_sai3": {
      "text": "祖国人降落至埼玉面前，故意摸了摸自己浓密的金发，嗤笑道：“一个秃子也配当英雄？你连头发都没有，像颗剥了壳的鸡蛋。”\n埼玉的眉头微微动了一下，那是他三年训练以来第一次被真正戳中痛点。他缓缓抬起头，眼神从死鱼变为——一种可怕的平静。“你再说一遍？”",
      "options": [
        {
          "text": "认真起来，直接释放【认真一拳】",
          "next_scene": "s_sai3_1"
        },
        {
          "text": "使用【连续普通拳】狂风暴雨般殴打",
          "next_scene": "s_sai3_2"
        },
        {
          "text": "用【认真往返跳】瞬间绕到祖国人身后",
          "next_scene": "s_sai3_3"
        }
      ]
    },
    "s_sai3_1": {
      "text": "埼玉的认真一拳的拳风擦过祖国人，将他半边身体的气化消失，但未伤及要害。祖国人残废，终生坐轮椅，却对埼玉产生了一种病态的敬畏。",
      "next_scene": "end"
    },
    "s_sai3_2": {
      "text": "密集拳雨将祖国人打成植物人，他躺在病床上，心电图微弱跳动。沃特公司试图掩盖真相，但超人公开了视频，正义虽迟但到。",
      "next_scene": "end"
    },
    "s_sai3_3": {
      "text": "埼玉出现在祖国人背后，轻轻在他耳边说：“别拿秃头开玩笑。”祖国人被吓得心跳骤停，但被抢救回来。从此他患上了恐怖症，连看到镜子里的自己都会尖叫，被送进精神病院。",
      "next_scene": "end"
    },
    "end": {
      "text": "故事结束。感谢游玩虚空竞技场！\n无论结局如何，纽约上空的这场神战都已铭刻在永恒之中。",
      "next_scene": "end"
    }
  }
}